#!/bin/bash
# ==============================================================================
# 流量消耗脚本（持续消耗 + 总量达标自动停止）
# 功能：
#   1. 上传流量消耗（iperf3）
#   2. 下载流量消耗（aria2c）
#   3. 持续运行，累计消耗达到 TOTAL_TRAFFIC_MB 后自动停止/关机
# ==============================================================================

# ===================== 配置区 =====================
# ----- 网络接口 -----
NETWORK_INTERFACE="eth0"          # 监控网卡，请用 ip link 查看实际名称

# ----- 总流量目标（核心） -----
# 累计消耗达到该值后停止任务；0 表示无限运行
# 单位 MB：10240 = 10GB，51200 = 50GB
TOTAL_TRAFFIC_MB=0

# 达标后的动作：exit = 退出脚本；shutdown = 关闭服务器
ACTION_WHEN_DONE="exit"

# ----- 上传流量配置（iperf3） -----
UPLOAD_SERVER_IP="speedtest.hkg12.hk.leaseweb.net"      # iperf3 服务端 IP
UPLOAD_SERVER_PORT=5201
UPLOAD_PARALLEL=3
UPLOAD_RATE_LIMIT_MBPS=0          # 0=不限速

# ----- 下载流量配置（aria2c） -----
DOWNLOAD_FILE_URL="http://hkg.download.datapacket.com/10000mb.bin"              # 大文件直链（必填，否则下载任务失败）
DOWNLOAD_ARIA2_THREADS=16
DOWNLOAD_RATE_LIMIT_MB=0
DOWNLOAD_DELETE_FILE_SIZE_MB=1024
DOWNLOAD_LOG_CLEAN_INTERVAL=43200

# ----- 随机调度配置 -----
# 两次任务之间的随机间隔（秒）；设 MIN=MAX=0 表示不间断持续消耗
RANDOM_INTERVAL_MIN=10
RANDOM_INTERVAL_MAX=60

# 单次任务随机流量范围（MB），最终会被剩余额度自动截断
TRAFFIC_PER_RUN_MIN_MB=100
TRAFFIC_PER_RUN_MAX_MB=500

# 流量方向：upload / download / both / random
TRAFFIC_DIRECTION="both"
# ===================== 配置结束 =====================

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; NC='\033[0m'

# 全局：最近一次任务实际消耗的字节数
LAST_USED_BYTES=0

optimize_alpine_network() {
    if [ -f /etc/alpine-release ]; then
        sysctl -w net.ipv4.tcp_congestion_control=bic >/dev/null 2>&1
        sysctl -w net.ipv4.tcp_window_scaling=1 >/dev/null 2>&1
        sysctl -w net.core.rmem_max=16777216 >/dev/null 2>&1
        sysctl -w net.core.wmem_max=16777216 >/dev/null 2>&1
        sysctl -w net.ipv4.tcp_rmem="4096 87380 16777216" >/dev/null 2>&1
        sysctl -w net.ipv4.tcp_wmem="4096 65536 16777216" >/dev/null 2>&1
        sysctl -w net.ipv4.tcp_no_metrics_save=1 >/dev/null 2>&1
        sysctl -w net.ipv4.tcp_syn_retries=2 >/dev/null 2>&1
        sysctl -w net.ipv4.tcp_fin_timeout=10 >/dev/null 2>&1
        ulimit -n 65535 >/dev/null 2>&1
    fi
}

check_deps() {
    local deps=("$@")
    for cmd in "${deps[@]}"; do
        if ! command -v "$cmd" &> /dev/null; then
            if [ -f /etc/debian_version ]; then
                apt update -y >/dev/null 2>&1 && apt install -y "$cmd" >/dev/null 2>&1
            elif [ -f /etc/redhat-release ]; then
                yum install -y "$cmd" >/dev/null 2>&1
            elif [ -f /etc/alpine-release ]; then
                apk update >/dev/null 2>&1 && apk add --no-cache "$cmd" >/dev/null 2>&1
            fi
        fi
    done
}

get_tx() { cat /sys/class/net/"$NETWORK_INTERFACE"/statistics/tx_bytes 2>/dev/null || echo 0; }
get_rx() { cat /sys/class/net/"$NETWORK_INTERFACE"/statistics/rx_bytes 2>/dev/null || echo 0; }

format_bytes_adaptive() {
    local bytes=$1
    if (( bytes < 1024 )); then echo "$bytes B"
    elif (( bytes < 1048576 )); then echo "$(echo "scale=1; $bytes/1024" | bc)KiB"
    elif (( bytes < 1073741824 )); then echo "$(echo "scale=1; $bytes/1048576" | bc)MiB"
    else echo "$(echo "scale=1; $bytes/1073741824" | bc)GiB"; fi
}

format_speed_adaptive() {
    local bps=$1
    if (( bps < 1024 )); then echo "$bps B/s"
    elif (( bps < 1048576 )); then echo "$(echo "scale=1; $bps/1024" | bc)KiB/s"
    elif (( bps < 1073741824 )); then echo "$(echo "scale=1; $bps/1048576" | bc)MiB/s"
    else echo "$(echo "scale=1; $bps/1073741824" | bc)GiB/s"; fi
}

generate_random_task_id() { printf "#%06x" $((RANDOM % 16777216)); }

declare -a CHILD_PIDS=()

cleanup() {
    for pid in "${CHILD_PIDS[@]}"; do
        kill "$pid" 2>/dev/null
    done
    wait 2>/dev/null
    CHILD_PIDS=()
}
trap cleanup EXIT INT TERM

# ---------- 上传流量 ----------
run_upload_traffic() {
    local threshold_mb=$1
    local rate_limit_mbps=$2
    local parallel=$3
    local server_ip=$4
    local server_port=$5

    LAST_USED_BYTES=0
    local threshold_bytes=$((threshold_mb * 1024 * 1024))
    local end_port=$((server_port + parallel - 1))
    local per_stream_limit=0
    if [ "$rate_limit_mbps" -gt 0 ]; then
        per_stream_limit=$((rate_limit_mbps / parallel))
        [ "$per_stream_limit" -lt 1 ] && per_stream_limit=1
    fi

    local start_tx=$(get_tx)
    local task_id=$(generate_random_task_id)
    local pids=()

    echo -e "${CYAN}[上传任务 ${task_id}] 目标 ${threshold_mb} MB，端口 ${server_port}~${end_port}${NC}"

    for ((i = 0; i < parallel; i++)); do
        local port=$((server_port + i))
        if [ "$rate_limit_mbps" -gt 0 ]; then
            iperf3 -c "$server_ip" -p "$port" -t 0 -b "${per_stream_limit}M" > /dev/null 2>&1 &
        else
            iperf3 -c "$server_ip" -p "$port" -t 0 > /dev/null 2>&1 &
        fi
        pids+=($!)
        CHILD_PIDS+=($!)
    done

    local last_tx=$start_tx
    local last_time=$(date +%s)
    local speed="0 B/s"
    local eta="--"
    local used_bytes=0

    while true; do
        for i in "${!pids[@]}"; do
            if [ ! -d /proc/${pids[$i]} ]; then
                local port=$((server_port + i))
                if [ "$rate_limit_mbps" -gt 0 ]; then
                    iperf3 -c "$server_ip" -p "$port" -t 0 -b "${per_stream_limit}M" > /dev/null 2>&1 &
                else
                    iperf3 -c "$server_ip" -p "$port" -t 0 > /dev/null 2>&1 &
                fi
                pids[$i]=$!
                CHILD_PIDS+=($!)
            fi
        done

        local now_tx=$(get_tx)
        used_bytes=$((now_tx - start_tx))
        local used_fmt=$(format_bytes_adaptive "$used_bytes")
        local progress=0
        [ "$threshold_bytes" -gt 0 ] && progress=$(awk "BEGIN {printf \"%.0f\", $used_bytes*100/$threshold_bytes}")

        local now_time=$(date +%s)
        if (( now_time - last_time >= 2 )); then
            local tx_diff=$((now_tx - last_tx))
            local speed_bps=$((tx_diff / (now_time - last_time)))
            speed=$(format_speed_adaptive "$speed_bps")
            if [ "$speed_bps" -gt 0 ]; then
                local eta_sec=$(awk "BEGIN {printf \"%.0f\", ($threshold_bytes - $used_bytes) / $speed_bps}")
                eta="$((eta_sec / 60))m$((eta_sec % 60))s"
            else
                eta="∞"
            fi
            last_tx=$now_tx
            last_time=$now_time
        fi

        echo -ne "\r${CYAN}[上传 ${task_id}] ${used_fmt}/${threshold_mb}MB (${progress}%) 速度:${speed} 剩余:${eta}${NC}   "

        if [ "$used_bytes" -ge "$threshold_bytes" ]; then
            echo -e "\n${GREEN}✅ 上传任务 ${task_id} 完成（${used_fmt}）${NC}"
            break
        fi
        sleep 1
    done

    for pid in "${pids[@]}"; do
        kill "$pid" 2>/dev/null
    done
    wait 2>/dev/null

    # 从全局 CHILD_PIDS 移除本次 pid（循环重建，避免管道语法）
    local new_child_pids=()
    local cpid ppid keep
    for cpid in "${CHILD_PIDS[@]}"; do
        keep=1
        for ppid in "${pids[@]}"; do
            if [ "$cpid" = "$ppid" ]; then keep=0; break; fi
        done
        [ "$keep" -eq 1 ] && new_child_pids+=("$cpid")
    done
    CHILD_PIDS=("${new_child_pids[@]}")

    LAST_USED_BYTES=$used_bytes
}

# ---------- 下载流量 ----------
run_download_traffic() {
    local threshold_mb=$1
    local rate_limit_mb=$2
    local file_url=$3
    local threads=$4
    local delete_size_mb=$5

    LAST_USED_BYTES=0
    if [ -z "$file_url" ]; then
        echo -e "${RED}下载任务跳过：DOWNLOAD_FILE_URL 未配置${NC}"
        return 1
    fi

    local threshold_bytes=$((threshold_mb * 1024 * 1024))
    local delete_size=$((delete_size_mb * 1024 * 1024))
    local limit_param=""
    [ "$rate_limit_mb" -gt 0 ] && limit_param="--max-download-limit=${rate_limit_mb}M"

    local start_rx=$(get_rx)
    local task_id=$(generate_random_task_id)
    local tmp_file="tmp_traffic_$$_${RANDOM}"
    local aria_pid=0
    local cleaned_flag="/tmp/cleaned_${tmp_file}.flag"
    rm -f "$cleaned_flag"

    echo -e "${CYAN}[下载任务 ${task_id}] 目标 ${threshold_mb} MB，线程 ${threads}${NC}"

    aria2c -x "$threads" -s "$threads" \
        --file-allocation=none --auto-file-renaming=false \
        --summary-interval=0 --disable-ipv6=true --allow-overwrite=true \
        --disk-cache=0 --timeout=10 --connect-timeout=5 \
        --max-concurrent-downloads=1 --min-split-size=1M \
        $limit_param \
        -o "$tmp_file" "$file_url" > /tmp/aria2_traffic.log 2>&1 &
    aria_pid=$!
    CHILD_PIDS+=($aria_pid)

    (
        while [ -d /proc/$aria_pid ] && [ ! -f "$cleaned_flag" ]; do
            if [ -f "$tmp_file" ]; then
                local file_size=$(stat -c %s "$tmp_file" 2>/dev/null || stat -f %z "$tmp_file" 2>/dev/null || echo 0)
                [[ ! "$file_size" =~ ^[0-9]+$ ]] && file_size=0
                if (( file_size >= delete_size )); then
                    > "$tmp_file"; truncate -s 0 "$tmp_file"
                    [ -f "${tmp_file}.aria2" ] && rm -f "${tmp_file}.aria2"
                    echo -e "\n${GREEN}✅ 下载文件已达 ${delete_size_mb}MB，已清空（下载继续）${NC}"
                    touch "$cleaned_flag"
                    while [ -d /proc/$aria_pid ]; do
                        [ -f "$tmp_file" ] && truncate -s 0 "$tmp_file" 2>/dev/null
                        [ -f "${tmp_file}.aria2" ] && rm -f "${tmp_file}.aria2" >/dev/null 2>&1
                        sleep 2
                    done
                fi
            fi
            sleep 0.5
        done
        rm -f "$cleaned_flag"
    ) &
    CHILD_PIDS+=($!)

    local last_rx=$start_rx
    local last_time=$(date +%s)
    local speed="0 B/s"
    local eta="--"
    local used_bytes=0

    while true; do
        if [ ! -d /proc/$aria_pid ]; then
            rm -f "$tmp_file" "${tmp_file}.aria2"
            tmp_file="tmp_traffic_$$_${RANDOM}"
            aria2c -x "$threads" -s "$threads" \
                --file-allocation=none --auto-file-renaming=false \
                --summary-interval=0 --disable-ipv6=true --allow-overwrite=true \
                --disk-cache=0 --timeout=10 --connect-timeout=5 \
                --max-concurrent-downloads=1 --min-split-size=1M \
                $limit_param \
                -o "$tmp_file" "$file_url" > /tmp/aria2_traffic.log 2>&1 &
            aria_pid=$!
            CHILD_PIDS+=($aria_pid)
        fi

        local now_rx=$(get_rx)
        used_bytes=$((now_rx - start_rx))
        local used_fmt=$(format_bytes_adaptive "$used_bytes")
        local progress=0
        [ "$threshold_bytes" -gt 0 ] && progress=$(echo "scale=0; if ($used_bytes == 0) 0 else $used_bytes * 100 / $threshold_bytes" | bc)

        local now_time=$(date +%s)
        if (( now_time - last_time >= 2 )); then
            local rx_diff=$((now_rx - last_rx))
            local speed_bps=$((rx_diff / (now_time - last_time)))
            speed=$(format_speed_adaptive "$speed_bps")
            if [ "$speed_bps" -gt 0 ]; then
                local eta_sec=$(echo "scale=0; ($threshold_bytes - $used_bytes) / $speed_bps" | bc)
                eta="$((eta_sec / 60))m$((eta_sec % 60))s"
            else
                eta="∞"
            fi
            last_rx=$now_rx
            last_time=$now_time
        fi

        echo -ne "\r${CYAN}[下载 ${task_id}] ${used_fmt}/${threshold_mb}MB (${progress}%) 速度:${speed} 剩余:${eta}${NC}   "

        if [ "$used_bytes" -ge "$threshold_bytes" ]; then
            echo -e "\n${GREEN}✅ 下载任务 ${task_id} 完成（${used_fmt}）${NC}"
            break
        fi
        sleep 1
    done

    kill "$aria_pid" 2>/dev/null
    wait 2>/dev/null
    rm -f "$tmp_file" "${tmp_file}.aria2" "$cleaned_flag" 2>/dev/null

    LAST_USED_BYTES=$used_bytes
}

# ---------- 随机工具 ----------
random_sleep() {
    local min=$1 max=$2
    local range=$((max - min + 1))
    local sec=$((RANDOM % range + min))
    echo -e "${YELLOW}⏳ 随机等待 ${sec} 秒后触发下一次任务...${NC}"
    sleep "$sec"
}

random_traffic_mb() {
    local min=$1 max=$2
    local range=$((max - min + 1))
    echo $((RANDOM % range + min))
}

pick_direction() {
    case "$1" in
        upload)   echo "upload" ;;
        download) echo "download" ;;
        both)     echo "both" ;;
        *) [ $((RANDOM % 2)) -eq 0 ] && echo "upload" || echo "download" ;;
    esac
}

# ---------- 入口 ----------
main() {
    exec 3>&1 4>&2
    exec 1>/dev/null 2>&1
    check_deps iperf3 bc stat truncate
    check_deps aria2c
    optimize_alpine_network
    exec 1>&3 4>&2

    local total_bytes=$((TOTAL_TRAFFIC_MB * 1024 * 1024))
    local consumed_bytes=0
    local rem_bytes rem_mb want_mb target_mb direction

    echo -e "${YELLOW}========================================${NC}"
    echo -e "${GREEN}流量消耗脚本（持续消耗 + 达标停止）${NC}"
    echo -e "${GREEN}网卡: ${NETWORK_INTERFACE}${NC}"
    if [ "$TOTAL_TRAFFIC_MB" -gt 0 ]; then
        echo -e "${GREEN}总目标: ${TOTAL_TRAFFIC_MB} MB（$(format_bytes_adaptive $total_bytes)）${NC}"
    else
        echo -e "${GREEN}总目标: 无限${NC}"
    fi
    echo -e "${GREEN}单次流量: ${TRAFFIC_PER_RUN_MIN_MB}~${TRAFFIC_PER_RUN_MAX_MB} MB${NC}"
    echo -e "${GREEN}方向策略: ${TRAFFIC_DIRECTION}${NC}"
    echo -e "${GREEN}达标动作: ${ACTION_WHEN_DONE}${NC}"
    echo -e "${YELLOW}========================================${NC}\n"

    while true; do
        rem_bytes=$((total_bytes - consumed_bytes))
        if [ "$TOTAL_TRAFFIC_MB" -gt 0 ] && [ "$rem_bytes" -le 0 ]; then
            echo -e "\n${GREEN}🎉 累计消耗已达到目标 ${TOTAL_TRAFFIC_MB} MB，停止任务${NC}"
            break
        fi

        random_sleep "$RANDOM_INTERVAL_MIN" "$RANDOM_INTERVAL_MAX"

        want_mb=$(random_traffic_mb "$TRAFFIC_PER_RUN_MIN_MB" "$TRAFFIC_PER_RUN_MAX_MB")
        direction=$(pick_direction "$TRAFFIC_DIRECTION")

        echo -e "\n${YELLOW}========== 触发新任务 ==========${NC}"
        echo -e "${GREEN}本次随机请求: ${want_mb} MB，方向: ${direction}${NC}"

        # 上传
        if [ "$direction" = "upload" ] || [ "$direction" = "both" ]; then
            target_mb=$want_mb
            if [ "$TOTAL_TRAFFIC_MB" -gt 0 ]; then
                rem_mb=$(( (total_bytes - consumed_bytes) / 1024 / 1024 ))
                [ "$target_mb" -gt "$rem_mb" ] && target_mb=$rem_mb
            fi
            if [ "$target_mb" -gt 0 ]; then
                run_upload_traffic "$target_mb" "$UPLOAD_RATE_LIMIT_MBPS" "$UPLOAD_PARALLEL" "$UPLOAD_SERVER_IP" "$UPLOAD_SERVER_PORT"
                consumed_bytes=$((consumed_bytes + LAST_USED_BYTES))
            fi
        fi

        # 下载
        if [ "$direction" = "download" ] || [ "$direction" = "both" ]; then
            target_mb=$want_mb
            if [ "$TOTAL_TRAFFIC_MB" -gt 0 ]; then
                rem_mb=$(( (total_bytes - consumed_bytes) / 1024 / 1024 ))
                [ "$target_mb" -gt "$rem_mb" ] && target_mb=$rem_mb
            fi
            if [ "$target_mb" -gt 0 ]; then
                run_download_traffic "$target_mb" "$DOWNLOAD_RATE_LIMIT_MB" "$DOWNLOAD_FILE_URL" "$DOWNLOAD_ARIA2_THREADS" "$DOWNLOAD_DELETE_FILE_SIZE_MB"
                consumed_bytes=$((consumed_bytes + LAST_USED_BYTES))
            fi
        fi

        echo -e "${CYAN}📊 累计已消耗: $(format_bytes_adaptive $consumed_bytes) / $(format_bytes_adaptive $total_bytes)${NC}"
    done

    # 达标动作
    cleanup
    if [ "$ACTION_WHEN_DONE" = "shutdown" ]; then
        echo -e "${RED}⚙️ 正在关闭服务器...${NC}"
        sync
        shutdown -h now
    else
        echo -e "${GREEN}脚本退出。${NC}"
        exit 0
    fi
}

main
